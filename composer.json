{
    "name": "pushinbr/pam-native-nitro",
    "description": "Ultra-fast offline-first data engine for PAM Native.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "pam",
        "pam-native",
        "database",
        "cache",
        "sqlite",
        "offline-first"
    ],
    "require": {
        "php": "^8.4",
        "pushinbr/pam-native": "^0.6.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Nitro\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pam\\Nitro\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.git",
            "/.github",
            "/.phpstan.cache",
            "/.phpunit.cache",
            "/composer.lock",
            "/vendor"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --configuration=phpstan.neon",
        "benchmark": "php benchmarks/cache.php"
    },
    "support": {
        "issues": "https://github.com/push-in/pam-native-nitro/issues",
        "source": "https://github.com/push-in/pam-native-nitro"
    },
    "homepage": "https://github.com/push-in/pam-native-nitro",
    "minimum-stability": "stable",
    "prefer-stable": true
}
